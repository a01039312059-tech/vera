  <script>
    (function () {
      var MAX = 3;
      var EAGER = 2;
      function notifyParent() {
        try {
          if (window.parent && window.parent !== window) {
            var h = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
            window.parent.postMessage({ type: "banner-iframe-resize", height: h }, "*");
          }
        } catch (e) {}
      }
      function loadBanners() {
        var imgs = Array.prototype.slice.call(document.querySelectorAll("img[data-src]"));
        if (!imgs.length) return;
        var queue = [];
        var inflight = 0;
        function pump() {
          while (inflight < MAX && queue.length) {
            var img = queue.shift();
            var url = img.getAttribute("data-src");
            if (!url || img.getAttribute("src")) continue;
            inflight++;
            var done = function () { inflight--; pump(); notifyParent(); };
            img.addEventListener("load", done, { once: true });
            img.addEventListener("error", done, { once: true });
            var pic = img.parentElement;
            if (pic) {
              var source = pic.querySelector("source[data-srcset]");
              if (source) source.setAttribute("srcset", source.getAttribute("data-srcset"));
            }
            img.setAttribute("src", url);
          }
        }
        function enqueue(img) {
          if (img.getAttribute("data-queued") === "1") return;
          img.setAttribute("data-queued", "1");
          queue.push(img);
          pump();
        }
        imgs.forEach(function (img, i) {
          img.setAttribute("width", "1200");
          img.setAttribute("height", "350");
          if (i < EAGER) enqueue(img);
        });
        if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              io.unobserve(entry.target);
              enqueue(entry.target);
            });
          }, { root: null, rootMargin: "400px 0px" });
          imgs.forEach(function (img, i) { if (i >= EAGER) io.observe(img); });
        } else {
          imgs.forEach(function (img, i) { if (i >= EAGER) enqueue(img); });
        }
        notifyParent();
      }
      window.__loadBanners = loadBanners;
    })();
    </script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const container = document.getElementById("bannerContainer");
      if (!container) return;

      const fixedItems = Array.from(container.querySelectorAll(".fixed-item"));
      const lastItem = container.querySelector(".fixed-last");
      const randomItems = Array.from(container.querySelectorAll(".random-item"));

      // 1. Fisher-Yates 셔플
      const shuffle = (items) => {
        for (let i = items.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [items[i], items[j]] = [items[j], items[i]];
        }
      };

      shuffle(randomItems);

      // 2. 랜덤 아이템 복사본 생성
      const newOrder = [...randomItems];

      // 3. 고정 위치 아이템을 지정된 순서대로 정확한 인덱스에 삽입 (누락 방지)
      fixedItems.sort((a, b) => {
        return parseInt(a.getAttribute("data-pos"), 10) - parseInt(b.getAttribute("data-pos"), 10);
      });

      fixedItems.forEach(item => {
        const pos = parseInt(item.getAttribute("data-pos"), 10);
        if (pos) {
          newOrder.splice(pos - 1, 0, item);
        }
      });

      // 4. 마지막 고정 아이템 추가
      if (lastItem) {
        newOrder.push(lastItem);
      }

      // 5. DOM 단 한 번의 조작으로 재삽입
      const fragment = document.createDocumentFragment();
      newOrder.forEach(item => fragment.appendChild(item));

      container.textContent = "";
      container.appendChild(fragment);
      if (window.__loadBanners) window.__loadBanners();
    });
  </script>
</body>
